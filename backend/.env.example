# =================================================================
# قالب متغيرات البيئة — انسخ هذا الملف باسم .env وعدّل القيم
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
#
# ملف .env نفسه لا يُرفع أبدًا لـ Git (موجود في .gitignore).
# هذا الملف (.env.example) هو الوحيد الآمن للمشاركة أو الرفع.
# =================================================================

# المنفذ اللي يستمع عليه السيرفر
PORT=8080

# المسار الكامل لمجلد حفظ البيانات — غيّره ليطابق مسارك الفعلي
TRACKER_DATA_DIR=D:\tracker-system\Tracker

# بيئة التشغيل (development / production)
NODE_ENV=production
